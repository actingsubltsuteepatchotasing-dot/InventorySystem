# ============================================================
# ตั้งค่า Supabase — คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
#
#   cp .env.local.example .env.local
#
# หาค่าได้ที่: Supabase Dashboard > Project Settings > API
#   Project URL       -> NEXT_PUBLIC_SUPABASE_URL
#   Project API keys > anon public -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# anon key เป็น public key เปิดเผยได้ ความปลอดภัยมาจาก RLS policy
# (ห้ามใช้ service_role key ในฝั่ง client เด็ดขาด)
#
# ตอน deploy: ใส่ค่าทั้งสองที่ Vercel > Project Settings > Environment Variables
# แล้ว Redeploy หนึ่งครั้ง (ตัวแปร NEXT_PUBLIC_ ถูกฝังตอน build)
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxx


# ============================================================
# ตั้งค่าผู้ช่วย AI (Gemini)
#
# *** สังเกตความต่างจากด้านบน: ตัวแปรกลุ่มนี้ไม่มี NEXT_PUBLIC_ นำหน้า ***
#
# Next.js จะฝังเฉพาะตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ ลงใน JavaScript
# ที่ส่งไปให้เบราว์เซอร์ ส่วนตัวแปรกลุ่มนี้อ่านได้เฉพาะฝั่งเซิร์ฟเวอร์
#
# ถ้าเผลอตั้งเป็น NEXT_PUBLIC_GEMINI_API_KEY คีย์จะหลุดไปกับหน้าเว็บทันที
# ใครเปิด DevTools ก็คัดลอกไปใช้จนโควตาฟรีของคุณหมดได้
#
# หาคีย์ได้ที่ https://aistudio.google.com/apikey (ฟรี)
#
# ตอน deploy: ใส่ที่ Vercel > Project Settings > Environment Variables
# แล้ว Redeploy หนึ่งครั้ง
# ============================================================

# จำเป็น — ถ้าไม่ใส่ ปุ่มผู้ช่วย AI จะยังอยู่แต่จะขึ้นข้อความบอกว่ายังไม่ได้ตั้งค่า
GEMINI_API_KEY=AIzaSy...

# ไม่บังคับ — ถ้าไม่ใส่จะใช้ gemini-2.0-flash ซึ่งเหมาะกับโควตาฟรี
# ถ้าเปลี่ยนไปใช้ gemini-2.5-* ระบบจะปิด thinking และเพิ่มเพดานคำตอบให้อัตโนมัติ
GEMINI_MODEL=gemini-2.0-flash

# ไม่บังคับ — จำกัดว่าใครใช้ผู้ช่วย AI ได้บ้าง คั่นด้วยจุลภาค
# เว้นว่าง = ทุกคนที่ล็อกอินแล้วใช้ได้
# แนะนำให้ตั้งถ้าเปิด public sign-up ที่ Supabase ไว้
CHAT_ALLOWED_EMAILS=


# ============================================================
# ที่อยู่เว็บ — ใช้ทำการ์ดพรีวิวตอนแชร์ลิงก์ใน LINE / Facebook / X
#
# LINE ไม่ยอมรับ path แบบสัมพัทธ์ ต้องเป็น URL เต็มเท่านั้น
#
# ไม่ใส่ก็ได้ ถ้า deploy บน Vercel ระบบจะหยิบโดเมนของ Vercel มาให้เอง
# แต่ถ้าใช้โดเมนของตัวเอง ต้องใส่ตรงนี้ ไม่งั้นรูปพรีวิวจะชี้ไปโดเมน Vercel
#
# ใส่แบบเต็มพร้อม https:// และไม่ต้องมี / ปิดท้าย
#
# ตอน deploy: ใส่ที่ Vercel > Project Settings > Environment Variables
# แล้ว Redeploy หนึ่งครั้ง (ตัวแปร NEXT_PUBLIC_ ถูกฝังตอน build)
# ============================================================

NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
